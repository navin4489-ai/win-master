{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=winmaster;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "WinMaster",
    "Audience": "WinMasterClients",
    "Secret": "winmaster-dev-super-secret-key-change-me-please-123456",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "License": {
    "SigningSecret": "winmaster-license-signing-secret-change-me"
  },
  "Bridge": {
    "BaseUrl": "http://localhost:3001",
    "Key": "dev-bridge-key"
  },
  "Evolution": {
    "BaseUrl": "",
    "ApiKey": ""
  },
  "Meta": {
    "VerifyToken": "winmaster-verify"
  }
}
