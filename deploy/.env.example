# Copy this to deploy/.env on the VM and replace every value with your own.
# Generate strong random secrets, e.g.:  openssl rand -base64 48
# Do NOT commit the real .env file.

# --- Postgres ---
POSTGRES_USER=winmaster
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=winmaster

# --- App secrets (use long random strings) ---
JWT_SECRET=CHANGE_ME_at_least_32_random_chars_for_jwt_signing
LICENSE_SIGNING_SECRET=CHANGE_ME_random_license_signing_secret
BRIDGE_KEY=CHANGE_ME_random_shared_bridge_key

# --- HTTPS (only needed for docker-compose.https.yml) ---
# Your domain whose A record points to this VM's public IP. Caddy gets a free
# TLS certificate for it automatically. Leave blank if using plain HTTP.
DOMAIN=winmaster.example.com

# --- Evolution API engine (only needed for docker-compose.evolution.yml) ---
# A shared API key for the Evolution server (any long random string) and its DB password.
EVOLUTION_API_KEY=CHANGE_ME_random_evolution_api_key
EVOLUTION_DB_PASSWORD=CHANGE_ME_evolution_db_password
